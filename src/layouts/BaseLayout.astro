
---
import "../styles/global.css";
import { resumeUrl, siteDescription, siteTitle, siteUrl } from "../data/site";
const {
  title = siteTitle,
  description = siteDescription,
  image = "/assets/profile.jpg",
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Luis Cielak",
  jobTitle: "Lead Product Designer",
  url: siteUrl,
  email: "mailto:luis@luiscielak.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Philadelphia",
    addressRegion: "PA",
    addressCountry: "US",
  },
  sameAs: ["https://linkedin.com/in/cielak", "https://github.com/luiscielak"],
  knowsAbout: ["Product Design", "User Experience", "User Research", "Interface Design", "Data Visualization", "Design Systems"],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090806" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="Luis Cielak" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/#hero" aria-label="Luis Cielak home">
        <img src="/assets/logo.svg" alt="Luis Cielak" width="361" height="48" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="/#hero">Home</a>
        <a href="/#projects">Projects</a>
        <a href="/#about-me">About</a>
        <a href={resumeUrl}>Resume</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <h2>Designing with purpose, clarity, and real-world impact. Rooted in research. Guided by systems. Delivered with care.</h2>
        <div class="socials">
          <a href="https://linkedin.com/in/cielak" aria-label="Luis Cielak on LinkedIn">LinkedIn</a>
          <a href="https://github.com/luiscielak" aria-label="Luis Cielak on GitHub">GitHub</a>
          <a href="mailto:luis@luiscielak.com" aria-label="Email Luis Cielak">Email</a>
        </div>
      </div>
      <a class="footer-email" href="mailto:luis@luiscielak.com">luis@luiscielak.com</a>
    </footer>
  </body>
</html>
