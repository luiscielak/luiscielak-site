---
const cardUrl = "https://luiscielak.com/card";
const title = "Luis Cielak — Digital Business Card";
const description = "Save Luis Cielak's contact card, book a conversation, or connect after an event.";
const links = [
  {
    label: "Save contact",
    href: "/luis-cielak.vcf",
    detail: "Download vCard",
    primary: true,
    download: true,
  },
  {
    label: "Book time",
    href: "https://calendar.app.google/BbuDXKhMLMjkupDt8",
    detail: "Schedule a conversation",
  },
  {
    label: "Email",
    href: "mailto:luis@luiscielak.com",
    detail: "luis@luiscielak.com",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/cielak",
    detail: "linkedin.com/in/cielak",
  },
  {
    label: "Website",
    href: "https://luiscielak.com",
    detail: "Portfolio + case studies",
  },
  {
    label: "The Hooman Loop",
    href: "https://thehoomanloop.com",
    detail: "Design, systems, AI workflows",
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe2" />
    <link rel="canonical" href={cardUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="Luis Cielak" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={cardUrl} />
    <meta property="og:image" content="https://luiscielak.com/assets/profile.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://luiscielak.com/assets/profile.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Luis Cielak",
      jobTitle: "Lead Product Designer / Creative Technologist",
      url: "https://luiscielak.com",
      email: "mailto:luis@luiscielak.com",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Philadelphia",
        addressRegion: "PA",
        addressCountry: "US",
      },
      worksFor: {
        "@type": "Organization",
        name: "The Hooman Loop",
        url: "https://thehoomanloop.com",
      },
      sameAs: ["https://linkedin.com/in/cielak", "https://github.com/luiscielak"],
    })} />
    <title>{title}</title>
  </head>
  <body>
    <main class="card-page" id="content">
      <section class="shell" aria-labelledby="card-title">
        <div class="meta-strip" aria-label="Card status">
          <span>LUIS CIELAK</span>
          <span>PHL · MX</span>
          <span>DIGITAL CARD</span>
        </div>

        <div class="hero-grid">
          <article class="profile-panel module">
            <div class="panel-topline">
              <span class="kicker">Product Design · Systems · AI</span>
              <span class="status">ACTIVE</span>
            </div>
            <div class="identity-lockup">
              <img src="/assets/profile.jpg" alt="Portrait of Luis Cielak" width="520" height="520" />
              <div>
                <p class="eyebrow">Lead Product Designer / Creative Technologist</p>
                <h1 id="card-title">Luis Cielak</h1>
                <p class="lede">I help teams turn complex products, workflows, and data into clearer digital systems.</p>
              </div>
            </div>
            <div class="signal-grid" aria-label="Quick context">
              <div>
                <strong>15+ yrs</strong>
                <span>Product design</span>
              </div>
              <div>
                <strong>PHL</strong>
                <span>Based in Philadelphia</span>
              </div>
              <div>
                <strong>EN / ES</strong>
                <span>Bilingual</span>
              </div>
            </div>
          </article>

          <aside class="qr-panel module" aria-labelledby="qr-title">
            <p class="kicker">Scan / Share</p>
            <h2 id="qr-title">Save this card</h2>
            <img class="qr" src="/assets/card-qr.png" alt="QR code for luiscielak.com/card" width="720" height="720" />
            <p class="qr-url">luiscielak.com/card</p>
          </aside>
        </div>

        <section class="actions module" aria-label="Contact actions">
          {links.map((link) => (
            <a class:list={["action", { primary: link.primary }]} href={link.href} {...(link.download ? { download: "Luis-Cielak.vcf" } : {})}>
              <span>{link.label}</span>
              <small>{link.detail}</small>
            </a>
          ))}
        </section>

        <section class="context-grid" aria-label="Ways to collaborate">
          <article class="module context-card">
            <p class="kicker">Consulting</p>
            <h2>The Hooman Loop</h2>
            <p>Design strategy, product UX, research, workshops, and practical AI workflows for teams working through complexity.</p>
          </article>
          <article class="module context-card">
            <p class="kicker">Community</p>
            <h2>Cursor Philly</h2>
            <p>Local AI/product/design community events, talks, and hands-on sessions for builders and curious teams.</p>
          </article>
        </section>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    --paper: #f3efe2;
    --paper-2: #e8dfc8;
    --ink: #11110f;
    --muted: #5f594c;
    --line: #11110f;
    --teal: #16b8a6;
    --teal-light: #d8f4ee;
    --white: #fffaf0;
    --grid: rgba(17, 17, 15, 0.08);
    color-scheme: light;
    font-family: "Space Grotesk", "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }
  html { background: var(--paper); }
  body {
    margin: 0;
    min-height: 100vh;
    color: var(--ink);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px),
      var(--paper);
    background-size: 24px 24px;
  }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 3px solid var(--teal); outline-offset: 4px; }
  img { display: block; max-width: 100%; }

  .card-page { min-height: 100vh; padding: clamp(16px, 4vw, 44px); }
  .shell { width: min(1080px, 100%); margin: 0 auto; }
  .module {
    background: rgba(255, 250, 240, 0.86);
    border: 2px solid var(--line);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .meta-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 2px solid var(--line);
    border-bottom: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .meta-strip span { padding: 10px 12px; border-right: 1px solid rgba(243, 239, 226, 0.34); text-align: center; }
  .meta-strip span:last-child { border-right: 0; }

  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 360px); gap: 18px; }
  .profile-panel { padding: clamp(18px, 4vw, 34px); }
  .panel-topline { display: flex; justify-content: space-between; gap: 16px; align-items: center; margin-bottom: 26px; }
  .kicker, .eyebrow, .status, .qr-url {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .kicker, .eyebrow { color: var(--muted); margin: 0; }
  .status { background: var(--teal); color: var(--ink); border: 2px solid var(--line); padding: 6px 10px; white-space: nowrap; }
  .identity-lockup { display: grid; grid-template-columns: 150px 1fr; gap: clamp(18px, 3vw, 30px); align-items: end; }
  .identity-lockup img { aspect-ratio: 1; object-fit: cover; border: 2px solid var(--line); filter: grayscale(100%) contrast(1.08); }
  h1, h2, p { margin-top: 0; }
  h1 { font-size: clamp(4rem, 12vw, 8.6rem); line-height: 0.82; letter-spacing: -0.08em; margin-bottom: 22px; max-width: 720px; }
  h2 { font-size: clamp(1.7rem, 4vw, 3.25rem); line-height: 0.9; letter-spacing: -0.06em; margin-bottom: 14px; }
  .lede { max-width: 640px; margin-bottom: 0; color: var(--ink); font-size: clamp(1.25rem, 2.7vw, 2rem); line-height: 1.15; font-weight: 700; letter-spacing: -0.035em; }
  .signal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 30px; border: 2px solid var(--line); background: var(--teal-light); }
  .signal-grid div { padding: 14px; border-right: 2px solid var(--line); }
  .signal-grid div:last-child { border-right: 0; }
  .signal-grid strong { display: block; font-size: clamp(1.35rem, 3vw, 2.3rem); line-height: 1; letter-spacing: -0.05em; }
  .signal-grid span { display: block; margin-top: 5px; color: var(--muted); font-size: 0.84rem; font-weight: 750; }

  .qr-panel { display: grid; align-content: start; gap: 14px; padding: 20px; background: var(--paper-2); }
  .qr-panel h2 { margin-bottom: 2px; }
  .qr { width: 100%; aspect-ratio: 1; border: 2px solid var(--line); background: var(--white); padding: 10px; }
  .qr-url { margin: 0; text-align: center; color: var(--muted); word-break: break-word; }

  .actions { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 18px; }
  .action { min-height: 112px; padding: 18px; border-right: 2px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; transition: transform 140ms ease, background 140ms ease; }
  .action:nth-child(3n), .action:last-child { border-right: 0; }
  .action:nth-child(n + 4) { border-top: 2px solid var(--line); }
  .action:hover { background: var(--teal-light); transform: translate(-2px, -2px); }
  .action.primary { background: var(--teal); }
  .action span { font-size: clamp(1.35rem, 3vw, 2.15rem); line-height: 0.95; letter-spacing: -0.055em; font-weight: 950; }
  .action small { color: var(--muted); font-size: 0.84rem; font-weight: 800; letter-spacing: 0.02em; }
  .action.primary small { color: var(--ink); }

  .context-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 18px; }
  .context-card { padding: clamp(18px, 3vw, 26px); min-height: 210px; }
  .context-card p:last-child { margin-bottom: 0; color: var(--muted); font-size: 1.03rem; line-height: 1.5; font-weight: 650; }

  @media (max-width: 820px) {
    .card-page { padding: 12px; }
    .meta-strip { grid-template-columns: 1fr; }
    .meta-strip span { border-right: 0; border-bottom: 1px solid rgba(243, 239, 226, 0.34); }
    .meta-strip span:last-child { border-bottom: 0; }
    .hero-grid, .context-grid { grid-template-columns: 1fr; }
    .identity-lockup { grid-template-columns: 96px 1fr; align-items: start; }
    h1 { font-size: clamp(3.1rem, 19vw, 5.5rem); }
    .lede { font-size: 1.18rem; }
    .signal-grid, .actions { grid-template-columns: 1fr; }
    .signal-grid div, .action { border-right: 0; border-bottom: 2px solid var(--line); }
    .signal-grid div:last-child, .action:last-child { border-bottom: 0; }
    .action:nth-child(n + 4) { border-top: 0; }
    .module { box-shadow: 5px 5px 0 var(--ink); }
  }

  @media (max-width: 460px) {
    .identity-lockup { grid-template-columns: 1fr; }
    .identity-lockup img { width: 112px; }
    .panel-topline { align-items: flex-start; flex-direction: column; }
  }
</style>
